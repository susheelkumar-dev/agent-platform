# ---- agent-service configuration. Copy to .env for local runs; set as secrets on Azure Container Apps / Render.
ENVIRONMENT=development           # production refuses to start without the settings marked (required)
LOG_LEVEL=INFO

# (required) Shared secret between the portfolio BFF and this service, 24+ chars. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=

# (required in production) Neon PostgreSQL, e.g.
#   postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# LLM providers, tried in order; at least one key is required. All have free tiers.
GROQ_API_KEY=                     # https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=                   # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=               # https://openrouter.ai/settings/keys
OPENROUTER_MODEL=inclusionai/ling-3.2-flash:free

# Optional tracing (LangSmith free developer plan)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-service

# GridTrade demo API (the gridtrade-api container). The account needs trades.approve for the one write tool,
# which always waits for a human approval.
GRIDTRADE_API_URL=http://127.0.0.1:5080/api
GRIDTRADE_USER=ops.analyst
GRIDTRADE_PASSWORD=
