# ---------------------------------------------------------------------------
# AI Agent Platform configuration. Every setting is an env var; JSON for lists/dicts.
# Full reference: docs/operations.md
# ---------------------------------------------------------------------------
ENVIRONMENT=development
PUBLIC_URL=http://127.0.0.1:8000

# Storage: SQLite for dev, PostgreSQL for production, or "memory" (non-persistent)
DATABASE_URL=sqlite+aiosqlite:///./data/platform.db
# DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_platform
AUTO_CREATE_SCHEMA=true

# Users: static demo tokens (dev) and/or OIDC JWT (production)
AUTH_MODES=["static"]
# AUTH_MODES=["jwt"]
# JWT_JWKS_URL=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys
# JWT_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# JWT_AUDIENCE=api://agent-platform
# JWT_TENANT_CLAIM=tid
# ROLE_PERMISSIONS={"platform-admin":["*"],"analyst":["inventory.read","trading.exposure.read","documents.read","documents.write"]}

# Service-to-service secrets (agents must use the same values). CHANGE ALL THREE in production.
REGISTRATION_TOKEN=platform-demo-registration-token
AGENT_SERVICE_TOKEN=agent-demo-service-token
SIGNING_SECRET=dev-signing-secret-change-me-0123456789
ALLOWED_AGENT_HOSTS=["*"]

# LLM gateway: mock (offline) | openai | azure_openai | anthropic | openai_compatible | ollama
LLM_PROVIDER=mock
LLM_MODEL=mock-1
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_API_VERSION=            # Azure OpenAI only
# LLM_FALLBACKS=["anthropic:<model>"]
# LLM_PROVIDERS={"anthropic":{"api_key":"..."}}
# LLM_PRICING={"<model>":[0.0, 0.0]}   # USD per 1k input / output tokens, for cost reports
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=<embedding-model>
# RESOLVER_MODE=hybrid        # keyword | llm | hybrid
# PLANNER_MODE=rule           # rule | llm

# Orchestration
ENGINE=native                 # native | langgraph
MAX_PARALLEL_STEPS=8
WORKFLOW_TIMEOUT_SECONDS=180
DEFAULT_RETRY_ATTEMPTS=3

# Operations
LOG_LEVEL=INFO
LOG_FORMAT=text               # json in production
HEALTH_CHECK_INTERVAL_SECONDS=15
RATE_LIMIT_PER_MINUTE=120
GUARDRAIL_MODE=flag           # off | flag | block
