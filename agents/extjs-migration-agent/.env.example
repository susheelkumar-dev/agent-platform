# Agent service. Values here are loaded at start; real environment variables win.
PORT=8120
AGENT_SERVICE_URL=http://127.0.0.1:8120
# Folders the agent may read Ext JS sources from, and where it writes projects.
# Separate several roots with ';' on Windows and ':' on macOS/Linux.
#   Windows example: EXTJS_MIGRATE_ROOTS=D:\AI-Imp
#                    EXTJS_MIGRATE_OUTPUT=D:\AI-Imp\migrations
EXTJS_MIGRATE_ROOTS=/work
EXTJS_MIGRATE_OUTPUT=/work/migrations
# LLM fallback for flagged code: none | ollama | platform (platform = the platform's LLM gateway)
EXTJS_MIGRATE_LLM=none
OLLAMA_URL=http://localhost:11434
EXTJS_MIGRATE_MODEL=qwen2.5-coder:7b
