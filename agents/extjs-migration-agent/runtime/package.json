{
  "name": "@extreact/runtime",
  "version": "1.1.0",
  "description": "Ext JS-style classes, data stores, controllers and components for React + TypeScript: the library migrated applications are written against.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:local": "npm run build && npm pack --pack-destination ../packages"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "jsdom": "24.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hosted": {
      "types": "./dist/hosted.d.ts",
      "import": "./dist/hosted.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": true
}
